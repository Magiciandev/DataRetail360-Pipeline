# Copia este archivo como `.env` y completa los valores. `.env` NO se sube a Git.

# Motor de destino: "sqlite" (listo para usar, ideal para revisar el proyecto) o "sqlserver"
DB_ENGINE=sqlserver

# --- SQL Server (ver Guía 2.2.2) ---
DB_HOST=localhost
DB_NAME=DataRetail360_DW
DB_DRIVER=ODBC Driver 17 for SQL Server
# yes = autenticación de Windows (sin usuario ni contraseña)
DB_TRUSTED_CONNECTION=yes
DB_USER=
DB_PASSWORD=

# --- SQLite (solo si DB_ENGINE=sqlite) ---
DB_SQLITE_PATH=data/datarretail360_dw.db

# --- Carpetas ---
DATA_DIR=data/sample
LAKE_DIR=data/lake
LOG_DIR=logs

# Sal para anonimizar el RUT de los clientes (OBLIGATORIA). Usa un texto largo y aleatorio.
RUT_SALT=cambia-este-valor-por-un-texto-largo-y-aleatorio
