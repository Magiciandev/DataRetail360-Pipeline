+   "outputs": [],
+   "source": [
+    "COLUMNAS_CAMPANA = [\"codigo_campana\", \"nombre_campana\", \"tipo_campana\", \"objetivo\", \"fecha_inicio\", \"fecha_fin\", \"presupuesto\"]\n",
+    "\n",
+    "def transformar_campanas(df: pd.DataFrame) -> tuple[pd.DataFrame, pd.DataFrame]:\n",
+    "    df = df.copy()\n",
+    "    rechazos = []\n",
+    "    df[\"codigo_campana\"] = q.normalizar_texto(df[\"codigo_campana\"], mayusculas=True)\n",
+    "    df, r = q.separar_rechazos(df, df[\"codigo_campana\"].isna() | (df[\"codigo_campana\"] == \"\"), \"codigo_vacio\"); rechazos.append(r)\n",
+    "    df[\"presupuesto\"] = pd.to_numeric(df[\"presupuesto\"], errors=\"coerce\").astype(\"float64\")\n",
+    "    df, r = q.separar_rechazos(df, ~(df[\"presupuesto\"] > 0), \"presupuesto_invalido\"); rechazos.append(r)\n",
+    "    for col in [\"fecha_inicio\", \"fecha_fin\"]:\n",
+    "        df[col] = q.parsear_fechas(df[col])\n",
+    "    df, r = q.separar_rechazos(df, df[\"fecha_inicio\"].isna() | df[\"fecha_fin\"].isna() | (df[\"fecha_fin\"] < df[\"fecha_inicio\"]),\n",
