+    "CLAVES_HECHO = [\"campana_key\", \"cliente_key\", \"producto_key\", \"canal_key\", \"fecha_key\"]\n",
+    "\n",
+    "def asignar_claves(c: pd.DataFrame) -> tuple[pd.DataFrame, pd.DataFrame]:\n",
