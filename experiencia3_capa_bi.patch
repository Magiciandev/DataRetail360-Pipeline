+   "source": [
+    "def transformar_contactos(df: pd.DataFrame) -> tuple[pd.DataFrame, pd.DataFrame]:\n",
+    "    from src.config import exigir_rut_salt\n",
+    "    df = df.copy()\n",
+    "    rechazos = []\n",
+    "\n",
+    "    df[\"fecha_envio\"] = q.parsear_fechas(df[\"fecha_envio\"])\n",
+    "    df, r = q.separar_rechazos(df, df[\"fecha_envio\"].isna(), \"fecha_invalida\"); rechazos.append(r)\n",
+    "    df, r = q.separar_rechazos(df, ~q.validar_ruts(df[\"rut\"]), \"rut_invalido\"); rechazos.append(r)\n",
+    "\n",
+    "    df[\"codigo_campana\"] = q.normalizar_texto(df[\"codigo_campana\"], mayusculas=True)\n",
+    "    df[\"sku\"] = q.normalizar_sku(df[\"sku_promocionado\"])\n",
+    "    df[\"canal\"] = q.canal_canonico(df[\"canal\"])\n",
+    "    df[\"respondio\"] = (q.normalizar_texto(df[\"respondio\"], mayusculas=True) == \"SI\").astype(int)\n",
+    "    df[\"rut_anonimizado\"] = q.anonimizar_serie(df[\"rut\"], exigir_rut_salt())      # el RUT no sigue más allá de este punto\n",
+    "    df = df.drop(columns=[\"rut\", \"sku_promocionado\"])\n",
+    "\n",
+    "    df, r = q.separar_rechazos(df, df.duplicated([\"codigo_campana\", \"rut_anonimizado\"], keep=\"first\"), \"contacto_duplicado\"); rechazos.append(r)\n",
+    "\n",
+    "    dim_campana = db.leer_tabla(engine, \"dim_campana\")\n",
+    "    dim_campana = dim_campana[dim_campana[\"campana_key\"] != -1].set_index(\"codigo_campana\")\n",
+    "    df, r = q.separar_rechazos(df, ~df[\"codigo_campana\"].isin(dim_campana.index), \"campana_desconocida\"); rechazos.append(r)\n",
+    "    inicio = pd.to_datetime(df[\"codigo_campana\"].map(dim_campana[\"fecha_inicio\"]))\n",
+    "    fin = pd.to_datetime(df[\"codigo_campana\"].map(dim_campana[\"fecha_fin\"]))\n",
+    "    df, r = q.separar_rechazos(df, (df[\"fecha_envio\"] < inicio) | (df[\"fecha_envio\"] > fin), \"fuera_de_campana\"); rechazos.append(r)\n",
+    "\n",
+    "    skus = set(db.leer_tabla(engine, \"dim_producto\")[\"sku\"])\n",
+    "    df, r = q.separar_rechazos(df, ~df[\"sku\"].isin(skus), \"sku_desconocido\"); rechazos.append(r)\n",
+    "    df, r = q.separar_rechazos(df, df[\"canal\"].isna(), \"canal_desconocido\"); rechazos.append(r)\n",
+    "    return df, q.consolidar_rechazos(*rechazos)"
+   ]
