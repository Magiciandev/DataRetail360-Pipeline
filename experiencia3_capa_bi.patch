+   "source": [
+    "### B.4 Atribución de ventas y costo asignado\n",
+    "- **Venta atribuida:** ventas netas (sin devoluciones) del mismo cliente y mismo producto dentro de la ventana; cada línea de venta se atribuye **a lo más a un contacto** (el más reciente), así K5 no cuenta dos veces.\n",
+    "- **Costo asignado:** presupuesto de la campaña ÷ clientes contactados (partes iguales; la suma por campaña cierra exacto con el presupuesto)."
+   ]
+  },
+  {
+   "cell_type": "code",
+   "execution_count": null,
+   "id": "a9ea5201",
+   "metadata": {},
+   "outputs": [],
+   "source": [
+    "def atribuir_ventas(contactos: pd.DataFrame) -> pd.DataFrame:\n",
+    "    consulta = \"\"\"\n",
+    "    SELECT f.id_transaccion, f.linea, d.fecha, p.sku, c.rut_anonimizado, f.monto_neto\n",
+    "    FROM fact_ventas f\n",
+    "    JOIN dim_fecha d    ON d.fecha_key = f.fecha_key\n",
+    "    JOIN dim_producto p ON p.producto_key = f.producto_key\n",
+    "    JOIN dim_cliente c  ON c.cliente_key = f.cliente_key\n",
+    "    WHERE f.devolucion = 0 AND f.producto_key <> -1 AND f.cliente_key <> -1\n",
+    "    \"\"\"\n",
+    "    with engine.connect() as conn:\n",
+    "        ventas = pd.read_sql(consulta, conn)\n",
+    "    ventas[\"fecha\"] = pd.to_datetime(ventas[\"fecha\"])\n",
+    "\n",
+    "    cruce = contactos[CLAVES_HECHO + [\"rut_anonimizado\", \"sku\", \"fecha_envio\"]].merge(ventas, on=[\"rut_anonimizado\", \"sku\"])\n",
+    "    en_ventana = (cruce[\"fecha\"] >= cruce[\"fecha_envio\"]) & (cruce[\"fecha\"] <= cruce[\"fecha_envio\"] + pd.Timedelta(days=VENTANA_ATRIBUCION_DIAS))\n",
+    "    cruce = cruce[en_ventana]\n",
+    "    # Último contacto: si la venta cae en la ventana de varias campañas, se la lleva la de envío más reciente\n",
+    "    cruce = (cruce.sort_values([\"fecha_envio\", \"campana_key\"], ascending=[False, False])\n",
+    "                  .drop_duplicates([\"id_transaccion\", \"linea\"], keep=\"first\"))\n",
+    "    assert not cruce.duplicated([\"id_transaccion\", \"linea\"]).any(), \"una venta quedó atribuida a más de un contacto\"\n",
+    "    return (cruce.groupby(CLAVES_HECHO, as_index=False)[\"monto_neto\"].sum()\n",
+    "                 .rename(columns={\"monto_neto\": \"monto_venta_atribuida\"}))\n",
+    "\n",
+    "\n",
+    "def construir_hechos(contactos: pd.DataFrame) -> pd.DataFrame:\n",
+    "    h = contactos.merge(atribuir_ventas(contactos), on=CLAVES_HECHO, how=\"left\")\n",
+    "    h[\"monto_venta_atribuida\"] = h[\"monto_venta_atribuida\"].fillna(0.0)\n",
+    "    h[\"compro\"] = (h[\"monto_venta_atribuida\"] > 0).astype(int)\n",
+    "    h[\"contactado\"] = 1\n",
+    "    dim_campana = db.leer_tabla(engine, \"dim_campana\").set_index(\"campana_key\")\n",
+    "    presupuesto = h[\"campana_key\"].map(dim_campana[\"presupuesto\"])\n",
+    "    h[\"costo_asignado\"] = (presupuesto / h.groupby(\"campana_key\")[\"campana_key\"].transform(\"size\")).round(2)\n",
+    "    # Ajuste de centavos: la suma por campaña debe cerrar exacto con el presupuesto\n",
+    "    residuo = dim_campana[\"presupuesto\"] - h.groupby(\"campana_key\")[\"costo_asignado\"].sum()\n",
+    "    primera = h.groupby(\"campana_key\").head(1).index\n",
+    "    h.loc[primera, \"costo_asignado\"] = (h.loc[primera, \"costo_asignado\"] + h.loc[primera, \"campana_key\"].map(residuo)).round(2)\n",
+    "    return h"
+   ]
+  },
