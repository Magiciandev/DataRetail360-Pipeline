+    "    v[\"canal_key\"] = v[\"canal\"].map(db.mapa_claves(engine, \"dim_canal\", \"canal\", \"canal_key\")).fillna(-1).astype(int)\n",
+    "    v[\"producto_key\"] = db.asignar_clave_scd2(v, db.leer_tabla(engine, \"dim_producto\"), \"sku\", \"fecha_envio\", \"producto_key\")\n",
+    "    v[\"cliente_key\"] = db.asignar_clave_scd2(v, db.leer_tabla(engine, \"dim_cliente\"), \"rut_anonimizado\", \"fecha_envio\", \"cliente_key\")\n",
